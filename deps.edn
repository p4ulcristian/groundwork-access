;; groundwork-access: who is asking, and what may they do. Sessions in Postgres, and
;; access: scopes, roles, memberships, the check in front of every handler,
;; the gates (Postgres's row rules), the leak test. One tree: source-code/groundwork_access/.
;; The server's; in the browser only the shape of "what may I do?"'s answer
;; (groundwork-access.api's .cljs half).
{:paths ["source-code"]

 :deps
 {;; Postgres: the queries, the table maps and their gates
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks,
  ;; a reference what it does on delete, update and when checked, an index as a map;
  ;; migrate! takes {:tables :extensions :functions :views}, a function a file or a made {:name :sql};
  ;; run-in-transaction! takes the caller's :log, where after-commit failures go
  io.github.p4ulcristian/groundwork-postgres   {:git/tag "v0.4.8" :git/sha "322b4b1"}
  ;; a handler's steps: the session step and the check are steps over groundwork-steps's
  ;; context; refuse, and the refusal's shape (the leak test is handed the app's runner)
  io.github.p4ulcristian/groundwork-steps {:git/tag "v0.1.0" :git/sha "ed9458e"}
  ;; the step that finds the session adds the person to the message's log
  io.github.p4ulcristian/groundwork-logs  {:git/tag "v0.1.3" :git/sha "8d1846e"}
  ;; the settings and options checked by their shapes; the leak test: params
  ;; made by malli's generator, which needs test.check
  metosin/malli                  {:mvn/version "0.20.3"}
  org.clojure/test.check         {:mvn/version "1.1.3"}
  ;; who is asking, written as JSON for Postgres
  metosin/jsonista               {:mvn/version "1.0.2"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need ACCESS_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the tests' meter, one per pool, made as an app makes its own (groundwork-postgres brings the same)
                       io.github.p4ulcristian/groundwork-metrics {:git/tag "v0.1.6" :git/sha "88ae7a3"}
                       ;; the tests' groundwork-shaped-json, made as an app makes its own; the tests' runner of a message reads and writes by it
                       io.github.p4ulcristian/groundwork-shaped-json {:git/tag "v0.2.2" :git/sha "1c0fcf9"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
